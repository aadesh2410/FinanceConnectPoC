# ── AI Provider ────────────────────────────────────────────────────────────────
# Set to "claude" to use the real Anthropic API, "mock" for offline demo mode
AI_MODE=claude

# Demo mode — keeps execution in dry-run (no real DB writes)
DEMO_MODE=true

# ── Anthropic API key (required when AI_MODE=claude) ───────────────────────────
# Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Upstash Redis (optional) ────────────────────────────────────────────────────
# Falls back to in-memory store for local dev — only needed for multi-instance deploy
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Snowflake (Phase 3 / future) ────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=FINANCE_POC
SNOWFLAKE_SCHEMA=EUC_SANDBOX
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
